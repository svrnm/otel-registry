---
// One card per instrumented app or library: the best option first, the rest under "Also available".
// Markup and classes follow opentelemetry.io's registry card so the page reads as a copy.
import type { RegistryEntry, RegistryOption } from '../registry/merge.ts';

interface Props {
  entry: RegistryEntry;
  languageName: (id: string) => string;
}
const { entry, languageName } = Astro.props;
const [first, ...rest] = entry.options;

const PACKAGES: Record<string, { url: string; icon: string }> = {
  npm: { url: 'https://npmjs.com/package/', icon: 'fab fa-npm' },
  packagist: { url: 'https://packagist.org/packages/', icon: 'fa-solid fa-box-open' },
  gem: { url: 'https://rubygems.org/gems/', icon: 'fa-solid fa-gem' },
  go: { url: 'https://pkg.go.dev/', icon: 'fa-brands fa-golang' },
  nuget: { url: 'https://www.nuget.org/packages/', icon: 'fa-solid fa-box-open' },
  pypi: { url: 'https://pypi.org/project/', icon: 'fa-brands fa-python' },
  hex: { url: 'https://hex.pm/packages/', icon: 'fa-brands fa-erlang' },
  crates: { url: 'https://crates.io/crates/', icon: 'fab fa-rust' },
  maven: { url: 'https://maven.org/artifact/', icon: 'fa-solid fa-feather' },
};
const TIER: Record<string, { text: string; badge: string; icon?: string }> = {
  native: { text: 'native', badge: 'text-bg-success', icon: 'fa-solid fa-puzzle-piece' },
  'first-party': { text: 'first party integration', badge: 'text-bg-success', icon: 'fa-solid fa-heart' },
  otel: { text: 'OpenTelemetry', badge: 'text-bg-primary', icon: 'fa-solid fa-binoculars' },
  'third-party': { text: 'third party', badge: 'text-bg-secondary', icon: 'fa-solid fa-people-group' },
};
const COLOURED = ['cpp', 'dotnet', 'erlang', 'elixir', 'go', 'java', 'js', 'lua', 'php', 'python', 'ruby', 'rust', 'swift'];

const pkg = (o: RegistryOption) => {
  if (!o.package) return undefined;
  const [ecosystem, ...name] = o.package.split(':');
  const known = PACKAGES[ecosystem];
  return known ? { href: known.url + name.join(':'), icon: known.icon, ecosystem } : undefined;
};
const primary = (o: RegistryOption) => o.repo ?? o.docs!;
const repoIcon = (url: string) => (url.startsWith('https://github.com/') ? 'fa-brands fa-github' : 'fab fa-git-alt');
const highlight = first.tier === 'native' || first.tier === 'first-party' ? 'border-success' : '';
const firstPkg = pkg(first);
---

<li
  class:list={['card my-3 registry-entry', highlight]}
  data-id={entry.id}
  data-kind={entry.kind}
  data-language={entry.language ?? ''}
  data-tiers={[...new Set(entry.options.map((o) => o.tier))].join(' ')}
>
  <div class="card-body container">
    <h4 class="card-title mb-0 d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-2">
      <a href={primary(first)} target="_blank" rel="noopener" class="me-auto">{entry.name}</a>
      <div class="d-flex flex-wrap gap-1 justify-content-sm-end">
        <a href={`?tier=${first.tier}`} class:list={['badge rounded-pill', TIER[first.tier].badge]} title={`Click to filter by ${TIER[first.tier].text}`}>
          <i class={TIER[first.tier].icon}></i> {TIER[first.tier].text}
        </a>
        {first.cncf && (
          <span class="badge rounded-pill text-bg-primary" title={`CNCF ${first.cncf} project`}>CNCF {first.cncf}</span>
        )}
      </div>
    </h4>
    <p class="card-text">
      <small class="text-body-secondary">
        by{" "}
        {first.tier === 'otel' ? (
          <span class="badge rounded-pill text-bg-primary">🔭 OpenTelemetry Authors 🔭</span>
        ) : first.maintainer ? (
          <a href={`https://github.com/${first.maintainer}`} target="_blank" rel="noopener" class="card-link">{first.maintainer}</a>
        ) : (
          <span>the vendor</span>
        )}
      </small>
    </p>
    <div class="row p-2">
      <div class="col col-md-9 col-lg-10">
        <div class="mb-3">{first.description ?? ''}</div>
        {rest.length > 0 && (
          <div class="also mb-2">
            <h6><i class="fa-solid fa-layer-group"></i> Also available</h6>
            <ul class="list-unstyled mb-0">
              {rest.map((o) => (
                <li>
                  <span class:list={['badge rounded-pill me-1', TIER[o.tier].badge]}>{TIER[o.tier].text}</span>
                  <a href={primary(o)} target="_blank" rel="noopener">{o.label}</a>
                  {o.license && <small class="text-body-secondary ms-1">{o.license}</small>}
                  {o.docs && o.repo && (
                    <a href={o.docs} target="_blank" rel="noopener" class="ms-2 small"><i class="fas fa-book" aria-hidden="true"></i> docs</a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
      <div class="col col-md-3 col-lg-2">
        <ul class="list-group list-group-flush">
          <li class="list-group-item">
            <div class="ms-2 me-auto">
              <div class="fw-bold">
                {entry.language ? (
                  <span class:list={['badge', COLOURED.includes(entry.language) ? `badge-${entry.language}` : 'text-bg-warning']}>{languageName(entry.language)}</span>
                ) : (
                  'Application'
                )}
              </div>
              <small>{entry.language ? 'Language' : 'Type'}</small>
            </div>
          </li>
          {first.license && (
            <li class="list-group-item">
              <div class="ms-2 me-auto">
                <div class="fw-bold">{first.license}</div>
                <small>License</small>
              </div>
            </li>
          )}
        </ul>
      </div>
    </div>
    {first.docs && (
      <a href={first.docs} target="_blank" rel="noopener" class="card-link"><i class="fas fa-book" aria-hidden="true"></i>&nbsp;Documentation</a>
    )}
    {firstPkg && (
      <a href={firstPkg.href} target="_blank" rel="noopener" class="card-link"><i class={firstPkg.icon} aria-hidden="true"></i>&nbsp;Package Details ({firstPkg.ecosystem})</a>
    )}
    {first.repo && (
      <a href={first.repo} target="_blank" rel="noopener" class="card-link"><i class={repoIcon(first.repo)} aria-hidden="true"></i>&nbsp;Repository</a>
    )}
  </div>
</li>
